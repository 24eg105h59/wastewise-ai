generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Business {
  id        String   @id @default(uuid())
  name      String
  type      String
  location  String?
  phone     String?
  createdAt DateTime @default(now())

  users            User[]
  products         Product[]
  categories       Category[]
  storageLocations StorageLocation[]
  alerts           Alert[]
  wasteRecords     WasteRecord[]
  tasks            Task[]
  scans            Scan[]
  auditLogs        AuditLog[]
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF") // ADMIN, MANAGER, STAFF
  businessId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id])
  scans         Scan[]
  auditLogs     AuditLog[]
  notifications Notification[]
  tasks         Task[]         @relation("AssignedTasks")
}

model Category {
  id         String @id @default(uuid())
  businessId String
  name       String

  business Business  @relation(fields: [businessId], references: [id])
  products Product[]
}

model StorageLocation {
  id                     String  @id @default(uuid())
  businessId             String
  name                   String
  type                   String
  requiredMinTemperature Float?
  requiredMaxTemperature Float?
  currentTemperature     Float?

  business Business  @relation(fields: [businessId], references: [id])
  products Product[]
}

model Product {
  id                String    @id @default(uuid())
  businessId        String
  name              String
  brand             String?
  categoryId        String?
  sku               String?
  barcode           String?
  quantity          Float     @default(0)
  unit              String    @default("units")
  price             Float?
  manufacturingDate DateTime?
  expiryDate        DateTime?
  bestBefore        DateTime?
  batchNumber       String?
  storageLocationId String?
  riskLevel         String    @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  imageUrl          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business        Business         @relation(fields: [businessId], references: [id])
  category        Category?        @relation(fields: [categoryId], references: [id])
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id])
  analyses        ProductAnalysis[]
  alerts          Alert[]
  wasteRecords    WasteRecord[]
  tasks           Task[]
}

model ProductAnalysis {
  id                 String   @id @default(uuid())
  productId          String
  imageUrl           String
  detectedProduct    String?
  ocrText            String?
  manufacturingDate  String?
  expiryDate         String?
  storageInstruction String?
  packagingCondition String?
  visualIndicators   String?
  riskLevel          String?
  confidence         String?
  aiSummary          String?
  createdAt          DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

model Alert {
  id         String   @id @default(uuid())
  businessId String
  productId  String?
  type       String
  severity   String // INFO, WARNING, CRITICAL
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  product  Product? @relation(fields: [productId], references: [id])
}

model WasteRecord {
  id             String   @id @default(uuid())
  businessId     String
  productId      String
  quantity       Float
  reason         String
  estimatedValue Float?
  notes          String?
  createdAt      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
}

model Task {
  id          String    @id @default(uuid())
  businessId  String
  productId   String?
  assignedTo  String?
  title       String
  description String?
  priority    String    @default("MEDIUM")
  status      String    @default("PENDING")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id])
  product  Product? @relation(fields: [productId], references: [id])
  user     User?    @relation("AssignedTasks", fields: [assignedTo], references: [id])
}

model Scan {
  id             String   @id @default(uuid())
  businessId     String
  userId         String
  imageUrl       String
  status         String
  analysisResult String?
  createdAt      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
